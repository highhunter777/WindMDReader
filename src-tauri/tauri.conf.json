{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WindMD",
  "version": "0.1.0",
  "identifier": "com.windmd.reader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WindMD",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "deb", "appimage"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Viewer"
      }
    ],
    "shortDescription": "本地优先的 Markdown 阅读器",
    "longDescription": "WindMD 是一款本地优先、高性能的 Markdown 阅读器,提供接近 IDE 级的大文件性能与接近出版级的阅读体验。",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "windows/nsis-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/shell-integration.wxs"],
        "componentRefs": ["WindMDShellIntegration"]
      }
    }
  }
}